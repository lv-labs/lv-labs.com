---
// src/components/Construction.astro
interface Props {
    logoSrc: string;
    logoAlt?: string;
    tagline?: string;
}

const { logoSrc, logoAlt = "lv-labs" } = Astro.props;
---

<body>
    <img src={logoSrc} alt={logoAlt} class="hero-logo" />

    <div class="tagline-content">
        <p id="tagline-original">electronic engineer & product designer</p>
    </div>

    <div class="construction">
        <p class="construction-text">[website under construction]</p>
    </div>
</body>

<style>
    :root {
        --logo-width: clamp(800px, 50vw, 1000px);
    }

    body {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100vh;
        pointer-events: none;
        font-family: "Doto";
    }

    .hero-logo {
        width: var(--logo-width);
        height: auto;
    }

    .tagline-content {
        font-size: 1rem;
        font-weight: 500;
        text-align: center;
        letter-spacing: 0.5rem;
        line-height: 1;
        max-width: var(--logo-width);
        color: #027b0e;
    }
</style>

<script></script>
