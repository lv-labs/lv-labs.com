---
import "../styles/global.css";
import Construction from "../components/Construction.astro";
import faviconUrl from "../assets/favicon.svg?url";
import logoUrl from "../assets/logo.svg?url";

const cells = Array.from({ length: 10000 });
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={faviconUrl} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>lv-labs</title>
	</head>
	<body>
		<div class="custom-cursor"></div>

		<div class="grid-background">
			{cells.map(() => <div class="grid-cell" />)}
		</div>
		<Construction logoSrc={logoUrl} logoAlt="lv-labs logo" />
	</body>
</html>

<style>
	body {
		overflow: hidden;
		cursor: none;
	}

	.custom-cursor {
		width: 24px;
		height: 24px;
		background-color: #464646;
		border-radius: 50%;
		position: fixed;
		top: 0;
		left: 0;
		pointer-events: none;
		z-index: 9999;
		transform: translate(-50%, -50%);
		will-change: transform;
	}

	.grid-background {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 200vh;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(40px, 1fr));
		grid-template-rows: repeat(auto-fill, minmax(40px, 1fr));
		pointer-events: all;
		z-index: 0;

		border-top: 1px solid rgba(0, 0, 0, 0.1);
		border-left: 1px solid rgba(0, 0, 0, 0.1);
	}

	.grid-cell {
		border-right: 1px solid rgba(0, 0, 0, 0.01);
		border-bottom: 1px solid rgba(0, 0, 0, 0.01);
		border-top: 1px solid rgba(0, 0, 0, 0.01);
		border-left: 1px solid rgba(0, 0, 0, 0.01);
		background-clip: padding-box;
	}
</style>

<script>
	const cursor = document.querySelector(".custom-cursor") as HTMLElement;

	let mouseX = 0;
	let mouseY = 0;
	let cursorX = 0;
	let cursorY = 0;
	const speed = 0.1;

	// Trail management
	const trail: HTMLElement[] = [];
	const maxSteady = 6; // Cells stay at full opacity for this many steps
	const fadeSteps = 3; // Then fade out over this many steps

	window.addEventListener("mousemove", (e) => {
		mouseX = e.clientX;
		mouseY = e.clientY;
	});

	function updateTrail(newEl: HTMLElement) {
		// If the cell is already in the trail, remove it so we can move it to the front
		const existingIndex = trail.indexOf(newEl);
		if (existingIndex !== -1) {
			trail.splice(existingIndex, 1);
		}

		trail.unshift(newEl);

		// Update all cells in the trail based on their position
		trail.forEach((cell, i) => {
			let opacity = 1;

			if (i >= maxSteady) {
				// Calculate fade percentage
				opacity = 1 - (i - maxSteady + 1) / fadeSteps;
			}

			if (opacity <= 0) {
				cell.style.backgroundColor = "";
				cell.style.borderColor = "";
			} else {
				cell.style.backgroundColor = `rgba(2, 123, 14, ${0.06 * opacity})`;
				cell.style.borderColor = `rgba(2, 123, 14, ${0.12 * opacity})`;
			}
		});

		// Remove truly invisible cells from the array
		if (trail.length > maxSteady + fadeSteps) {
			const removed = trail.pop();
			if (removed) {
				removed.style.backgroundColor = "";
				removed.style.borderColor = "";
			}
		}
	}

	function animate() {
		cursorX += (mouseX - cursorX) * speed;
		cursorY += (mouseY - cursorY) * speed;

		if (cursor) {
			cursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0) translate(-50%, -50%)`;

			const el = document.elementFromPoint(
				cursorX,
				cursorY,
			) as HTMLElement;
			if (el && el.classList.contains("grid-cell") && trail[0] !== el) {
				updateTrail(el);
			}
		}

		requestAnimationFrame(animate);
	}

	animate();
</script>
