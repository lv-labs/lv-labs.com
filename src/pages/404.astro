---
import "../styles/global.css";
import faviconUrl from "../assets/favicon.svg?url";
import logoUrl from "../assets/logo.svg?url";

const cells = Array.from({ length: 10000 });
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={faviconUrl} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>404 | lv-labs</title>
	</head>
	<body>
		<div class="custom-cursor"></div>

		<div class="grid-background">
			{cells.map(() => <div class="grid-cell" />)}
		</div>

		<main class="not-found">
			<img src={logoUrl} alt="lv-labs logo" class="hero-logo" />
			<p class="status-code">404</p>
			<p class="message">page not found</p>
			<a href="/" class="home-link">return home</a>
		</main>
	</body>
</html>

<style>
	:root {
		--logo-width: clamp(800px, 50vw, 1000px);
	}

	body {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: 100vh;
		overflow: hidden;
		cursor: none;
		font-family: "Doto";
	}

	.custom-cursor {
		width: 24px;
		height: 24px;
		background-color: #464646;
		border-radius: 50%;
		position: fixed;
		top: 0;
		left: 0;
		pointer-events: none;
		z-index: 9999;
		transform: translate(-50%, -50%);
		will-change: transform;
	}

	.grid-background {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 200vh;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(40px, 1fr));
		grid-template-rows: repeat(auto-fill, minmax(40px, 1fr));
		pointer-events: all;
		z-index: 0;
		border-top: 1px solid rgba(0, 0, 0, 0.1);
		border-left: 1px solid rgba(0, 0, 0, 0.1);
	}

	.grid-cell {
		border-right: 1px solid rgba(0, 0, 0, 0.01);
		border-bottom: 1px solid rgba(0, 0, 0, 0.01);
		border-top: 1px solid rgba(0, 0, 0, 0.01);
		border-left: 1px solid rgba(0, 0, 0, 0.01);
		background-clip: padding-box;
	}

	.not-found {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		pointer-events: none;
	}

	.hero-logo {
		width: var(--logo-width);
		height: auto;
	}

	.status-code,
	.message,
	.home-link {
		margin: 0;
		letter-spacing: 0.5rem;
		text-transform: lowercase;
	}

	.status-code {
		font-size: 1.6rem;
		color: #027b0e;
	}

	.message {
		font-size: 1rem;
		color: #464646;
	}

	.home-link {
		pointer-events: auto;
		color: #027b0e;
		text-decoration: none;
		border-bottom: 1px solid rgba(2, 123, 14, 0.35);
		padding-bottom: 0.2rem;
	}

	.home-link:hover {
		border-bottom-color: #027b0e;
	}
	
	@media (max-width: 900px) {
		:root {
			--logo-width: min(90vw, 800px);
		}

		.status-code {
			font-size: 1.2rem;
		}

		.message,
		.home-link {
			font-size: 0.85rem;
			letter-spacing: 0.3rem;
		}
	}
</style>

<script>
	const cursor = document.querySelector(".custom-cursor") as HTMLElement;

	let mouseX = 0;
	let mouseY = 0;
	let cursorX = 0;
	let cursorY = 0;
	const speed = 0.1;

	const trail: HTMLElement[] = [];
	const maxSteady = 6;
	const fadeSteps = 3;

	window.addEventListener("mousemove", (e) => {
		mouseX = e.clientX;
		mouseY = e.clientY;
	});

	function updateTrail(newEl: HTMLElement) {
		const existingIndex = trail.indexOf(newEl);
		if (existingIndex !== -1) {
			trail.splice(existingIndex, 1);
		}

		trail.unshift(newEl);

		trail.forEach((cell, i) => {
			let opacity = 1;

			if (i >= maxSteady) {
				opacity = 1 - (i - maxSteady + 1) / fadeSteps;
			}

			if (opacity <= 0) {
				cell.style.backgroundColor = "";
				cell.style.borderColor = "";
			} else {
				cell.style.backgroundColor = `rgba(2, 123, 14, ${0.06 * opacity})`;
				cell.style.borderColor = `rgba(2, 123, 14, ${0.12 * opacity})`;
			}
		});

		if (trail.length > maxSteady + fadeSteps) {
			const removed = trail.pop();
			if (removed) {
				removed.style.backgroundColor = "";
				removed.style.borderColor = "";
			}
		}
	}

	function animate() {
		cursorX += (mouseX - cursorX) * speed;
		cursorY += (mouseY - cursorY) * speed;

		if (cursor) {
			cursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0) translate(-50%, -50%)`;

			const el = document.elementFromPoint(
				cursorX,
				cursorY,
			) as HTMLElement;
			if (el && el.classList.contains("grid-cell") && trail[0] !== el) {
				updateTrail(el);
			}
		}

		requestAnimationFrame(animate);
	}

	animate();
</script>
